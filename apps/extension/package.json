{
  "name": "@marklayer/extension",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "bun run zip && bun run zip:firefox",
    "check": "tsc --noEmit",
    "test": "bun test lib",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@marklayer/types": "workspace:*",
    "@preact/signals": "^2.11.1",
    "idb-keyval": "^6.3.0",
    "lucide-preact": "^1.37.0",
    "nanoid": "^6.0.0",
    "perfect-freehand": "^1.2.3",
    "preact": "^10.29.8",
    "simple-icons": "^16.29.0",
    "tinykeys": "^4.0.0"
  }
