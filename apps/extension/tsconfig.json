{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // `bun` for the `bun:test` module the specs import. Naming it here turns off
    // tsc's automatic @types inclusion, which is fine: WXT's own globals arrive
    // through .wxt/wxt.d.ts, not through a @types package.
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // `paths` replaces (not merges with) the WXT-generated set in .wxt/tsconfig.json,
    // so the @/~ aliases are carried over alongside the react -> preact/compat type
    // mappings that @base-ui/react needs. Relative to this tsconfig's directory.
    "paths": {
      "@": ["./.wxt/.."],
      "@/*": ["./*"],
      "~": ["./.wxt/.."],
      "~/*": ["./*"],
      "@@": ["./.wxt/.."],
      "@@/*": ["./*"],
      "~~": ["./.wxt/.."],
      "~~/*": ["./*"],
      "react": ["./node_modules/preact/compat"],
      "react-dom": ["./node_modules/preact/compat"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"]
    }
  }
}
