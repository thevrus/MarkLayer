{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "vite/client", "bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@ext/*": ["../extension/*"],
      "@site/*": ["../site/src/*"],
      "react": ["./node_modules/preact/compat", "../../node_modules/preact/compat"],
      "react-dom": ["./node_modules/preact/compat", "../../node_modules/preact/compat"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime", "../../node_modules/preact/jsx-runtime"]
    }
  },
  "include": ["src", "web", "shared", "../extension/components", "../extension/lib"],
  // 扩展端的测试文件由 apps/extension 自己的 tsconfig（DOM lib）检查；
  // 这里再纳进来会和 @cloudflare/workers-types 的全局声明打架
  // （Element.remove()、Response、Document.append 等签名不同），报一堆伪错误。
  "exclude": ["../extension/**/*.test.ts", "../extension/**/*.test.tsx"]
}
