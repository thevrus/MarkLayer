{
  "name": "@marklayer/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run sync:shell && vite build && bun run embed:site && bun run build:widget",
    "build:widget": "bun ../extension/widget/build.ts public/client",
    "embed:site": "node scripts/embed-site.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "sync:shell": "node scripts/sync-shell.mjs",
    "migrations:bootstrap": "node scripts/bootstrap-migrations.mjs",
    "test": "bun test src web shared"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@hono/zod-openapi": "^1.6.1",
    "@marklayer/agent-tools": "workspace:*",
    "@marklayer/brand": "workspace:*",
    "@marklayer/emails": "workspace:*",
    "@marklayer/site": "workspace:*",
    "@marklayer/tokens": "workspace:*",
    "@marklayer/types": "workspace:*",
    "@marklayer/ui": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "@preact/signals": "^2.11.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.5",
    "lucide-preact": "^1.37.0",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^6.0.0",
    "pdfjs-dist": "6.3.289",
    "posthog-js": "^1.422.5",
    "preact": "^10.29.8",
    "simple-icons": "^16.29.0",
    "tinykeys": "^4.0.0",
    "wouter-preact": "^3.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@happy-dom/global-registrator": "^20.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
