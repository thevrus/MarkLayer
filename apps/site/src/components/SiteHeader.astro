---
import { Search } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import { getDocsNav } from '../lib/docs-nav';
import { REPO_URL, SECTIONS, sectionFor } from '../lib/site';
import DocsNav from './DocsNav.astro';
import DocsSearch from './DocsSearch.astro';
import Logo from './Logo.astro';

interface Props {
  /** This page's path. Lights the section it is in, and the row it is in the phone menu. */
  path: string;
}

const { path } = Astro.props;
const current = sectionFor(path);
const nav = await getDocsNav();
---

{/* The landing page's bar: glass, sticky, the lockup on the left and the
    sections as quiet pills on the right, with the GitHub mark closing the row.
    Below `lg` the sections do not fit on one line, and a wrapped sticky bar eats
    a third of a phone, so they move into a menu sheet. */}
<header class="ml-nav">
  <div class="mx-auto flex h-14 w-full max-w-page items-center justify-between gap-6 px-(--gutter)">
    <a class="ml-wordmark" href="/" aria-label="visual collaboration home">
      <Logo size={26} class="shrink-0" />
      visual collaboration
    </a>
    {/* Each end cancels its own child's inner padding, so the ink at both ends
        lands on the column's edge: a pill holds its label 12px in, the icon
        holds its 18px glyph 9px in. */}
    <nav class="-ml-3 -mr-[9px] hidden items-center lg:flex" aria-label="Sections">
      {
        SECTIONS.map((s) => (
          <a
            class="ml-nav-link"
            href={s.href}
            data-active={s.key === current ? '' : undefined}
            aria-current={s.href === path ? 'page' : undefined}
          >
            {s.label}
          </a>
        ))
      }
      <a class="ml-nav-icon ms-1" href={REPO_URL} target="_blank" rel="noopener noreferrer">
        <span class="sr-only">GitHub</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siGithub.path}></path></svg>
      </a>
    </nav>
    <div class="-mr-[9px] flex items-center lg:hidden">
      <button
        type="button"
        class="ml-nav-icon cursor-pointer border-0 bg-transparent"
        commandfor="ml-search"
        command="show-modal"
        data-ml-search-open
        aria-haspopup="dialog"
      >
        <span class="sr-only">Search</span>
        <Search size={18} />
      </button>
      <button type="button" class="ml-nav-icon ml-menu-btn cursor-pointer border-0 bg-transparent" popovertarget="ml-menu">
        <span class="sr-only">Menu</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <line x1="3" y1="6.5" x2="15" y2="6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
          <line x1="3" y1="11.5" x2="15" y2="11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="ml-menu" class="ml-menu lg:hidden" popover>
    <DocsNav nav={nav} path={path} />
    <ul class="ml-docnav-list ml-menu-rest">
      {
        SECTIONS.filter((s) => s.key === 'pricing' || s.key === 'support').map((s) => (
          <li>
            <a class="ml-docnav-link" href={s.href} aria-current={s.href === path ? 'page' : undefined}>
              {s.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="ml-docnav-link" href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      </li>
    </ul>
  </div>
</header>
<DocsSearch nav={nav} />
