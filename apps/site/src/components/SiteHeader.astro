---
import Logo from './Logo.astro';
import { REPO_URL, SECTIONS, type Section } from '../lib/site';

interface Props {
  /** Omit the current section's own link so the nav never points at this page. */
  current?: Section;
}

const { current } = Astro.props;
---

{/* The same nav the app's own landing page carries: the lockup on the left, the
    sections as quiet pill links on the right, the GitHub mark closing the row,
    and no rule underneath. It used to be a smaller flat-purple lockup over a
    hairline with grey text links, which read as a different site from the one
    the header links back to. Separation here is whitespace, as it is on `/`. */}
<header class="mb-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
  <a class="ml-wordmark" href="/" aria-label="MarkLayer home">
    <Logo size={34} class="shrink-0" />
    MarkLayer
  </a>
  {/* Each end cancels its own child's inner padding, and the two are not the
      same number: a pill holds its label 12px in, the icon holds its 18px glyph
      9px in. Pulling both by 12 would hang the GitHub mark 3px past the column
      the article below is set in. So the ink at each end lands on the column's
      edge — which is also what makes the row read as aligned when it wraps
      under its own wordmark on a phone. */}
  <nav class="-ml-3 -mr-[9px] flex flex-wrap items-center gap-y-1" aria-label="Sections">
    {
      SECTIONS.filter((s) => s.key !== current).map((s) => (
        <a class="ml-nav-link" href={s.href}>
          {s.label}
        </a>
      ))
    }
    {/* The real mark, bare and in the row's own colour — no tile behind it. */}
    <a class="ml-nav-icon" href={REPO_URL} target="_blank" rel="noopener noreferrer">
      <span class="sr-only">GitHub</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
        ></path>
      </svg>
    </a>
  </nav>
</header>
