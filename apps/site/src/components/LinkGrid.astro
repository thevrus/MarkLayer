---
interface Props {
  links: { href: string; label: string }[];
}

const { links } = Astro.props;
---

{/* Ruled rows rather than bordered cards: one hairline per row, and a diagonal
    that travels on hover. Nothing lifts, nothing glows. */}
<div class="ml-rows">
  {
    links.map((l) => (
      <a class="ml-row" href={l.href}>
        <span>{l.label}</span>
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
          <path
            d="M2.5 8.5 8.5 2.5M3.9 2.5h4.6v4.6"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    ))
  }
</div>
