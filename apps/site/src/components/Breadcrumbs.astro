---
import type { Crumb } from '../lib/schema';

interface Props {
  crumbs: Crumb[];
  /** Replaces the default bottom margin, for a row that sets its own spacing. */
  class?: string;
  /** Drop the current page's crumb on a phone, where it wraps to three lines
      right above the same words as the h1. */
  compact?: boolean;
}

const { crumbs, class: className = 'mb-6', compact = false } = Astro.props;
const tail = (i: number) => (compact && i === crumbs.length - 1 && !crumbs[i]?.path ? 'max-sm:hidden' : undefined);
---

<nav class:list={['flex flex-wrap items-center gap-x-2 gap-y-1 text-label text-meta', className]} aria-label="Breadcrumb">
  {
    crumbs.map((c, i) => (
      <>
        {i > 0 && (
          <span class:list={['text-faint', tail(i)]} aria-hidden="true">
            /
          </span>
        )}
        {c.path ? (
          <a class="text-meta no-underline transition-colors duration-150 hover:text-ink" href={c.path}>
            {c.name}
          </a>
        ) : (
          <span class:list={['text-ink', tail(i)]}>{c.name}</span>
        )}
      </>
    ))
  }
</nav>
