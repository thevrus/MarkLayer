---
import HomeContent from '../components/home/HomeContent.astro';
import schema from '../data/home-schema.json';
import dates from '../data/page-dates.json';
import { getReleases } from '../lib/collections';
import { FONTS_HREF, OG_IMAGE, ORIGIN, WORKER_DEV } from '../lib/site';

/**
 * The application shell for `/`.
 *
 * Astro owns this document, but it is not a normal Astro page: the output is
 * handed to apps/worker's Vite build as its HTML entry, so Vite injects the
 * hashed SPA bundle and stylesheet into it. That is why the entry <script> and
 * the theme-flash script are `is:inline` — Astro must leave them for Vite.
 *
 * Everything inside #app is prerendered marketing content that main.tsx wipes
 * on boot. It exists for crawlers and for first paint before the bundle lands.
 */
const title = 'MarkLayer · Free, Anonymous Webpage Annotation. No Account.';
const description =
  'Free web app for annotating any live webpage. Paste a URL, draw and comment on the page, then share a link. No account, no email, no install. Open source.';
const ogTitle = 'MarkLayer · Free & Anonymous Webpage Annotation';
const ogDescription =
  'Free web app. Paste any URL, draw and comment on the live page, share a link. 100% free, 100% anonymous. No account, no email, no sign-up, nothing to install.';
const twitterDescription =
  'Free web app. Paste a URL, draw and comment in your browser, share a link. Real-time collab. No account, no email, no sign-up, nothing to install.';

/* The version and the modified date are derived, never stored in the graph: the
   releases collection is the public version number (the changelog reads the same
   entry) and page-dates.json is what the sitemap tells crawlers about `/`. Held
   in the JSON, both drift the moment someone bumps one and not the other. */
const softwareVersion = (await getReleases()).at(0)?.data.version;
if (!softwareVersion) throw new Error('home-schema: no releases to take softwareVersion from');
const dateModified = dates.home.modified;

/* home-schema.json's Chrome Extension node carries a real aggregateRating (5.0,
   3 ratings) read off the Chrome Web Store listing on 2026-09-03 — not invented,
   and not copied onto the WebApplication node, which has no review mechanism of
   its own. Re-check the CWS listing occasionally and update the JSON by hand;
   nothing here re-fetches it. */

const ld = {
  ...schema,
  '@graph': schema['@graph'].map((node) => {
    if (node['@type'] === 'WebSite') return { ...node, dateModified };
    if (node['@type'] === 'WebApplication') return { ...node, dateModified, softwareVersion };
    return node;
  }),
};
---

<!doctype html>
<html lang="en" data-marklayer="1">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:url" content={ORIGIN} />
    <meta property="og:site_name" content="MarkLayer" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="robots" content="max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={`${ORIGIN}/`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM-readable full text" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONTS_HREF} rel="stylesheet" media="print" onload="this.media = 'all'" />
    <noscript><link href={FONTS_HREF} rel="stylesheet" /></noscript>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />

    {/* Styles come from apps/worker: Vite injects its hashed stylesheet when it
        processes the built shell. `astro dev` never runs that build, so borrow
        the Worker's dev stylesheet. `?direct` because Vite serves a bare .css
        URL as a JS module for HMR, which is a MIME mismatch for <link>. */}
    {import.meta.env.DEV && <link rel="stylesheet" href={`${WORKER_DEV}/web/style.css?direct`} />}
  </head>
  <body>
    <script is:inline>
      (() => {
        var t = localStorage.getItem('ml-theme');
        if (t === 'dark' || t === 'light') document.documentElement.classList.add(t);
      })();
    </script>
    <div id="app">
      <div class="ml-force-light min-h-screen bg-white font-['Geist',system-ui,sans-serif]">
        {/* Flat white, no card, no shadow, no rounding: separation comes from
            whitespace. The copy is left-aligned prose — centring it threw the
            tables, lists and FAQ on this page off-axis. */}
        <main id="ssr" class="max-w-page mx-auto" style="padding: 3rem 1.5rem; text-align: left">
          <HomeContent />
        </main>
      </div>
    </div>
    {/* Vite rewrites this into the hashed bundle when it processes the built
        shell. In `astro dev` that bundle lives on the Worker's origin, so point
        there and `/` renders the real Landing here too. */}
    <script
      type="module"
      src={import.meta.env.DEV ? `${WORKER_DEV}/web/main.tsx` : '/web/main.tsx'}
      is:inline
    ></script>
  </body>
</html>
