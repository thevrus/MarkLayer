---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { ORIGIN, SUPPORT_CHANNEL, SUPPORT_PAID } from '../lib/site';

// Where Polar sends someone after they pay — the "Success URL" on the checkout
// product. It lives here, in the static site, rather than in the app: the
// checkout opens in a new tab (the original one holds unsaved annotations), so
// this page is only ever a full-page ending, never something rendered over work.
// Astro prerenders it, so a thank-you costs no Worker invocation.
//
// Polar appends `?checkout_id=…` on the redirect. Nothing here reads it: the
// page has no claim to make about the order that the receipt does not make
// better, and a static page could not verify an ID anyway.
const title = 'Thank you · MarkLayer';
const description = 'Your support for MarkLayer came through. It pays for the servers the free tools run on.';
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} canonical={`${ORIGIN}/thanks`} ogType="website" noindex />
  </head>
  <body>
    <div class="ml-shell">
      <SiteHeader />
      {/* The same painting `/support` opened with: the last thing seen before
          paying is the first thing seen after, so the two read as one moment.
          Both classes are shared with that page from global.css. */}
      <div class="ml-park"></div>
      {/* The heading wears the product's own mark: one pen stroke under the
          words, the same gesture the page cards draw under a heading's
          operative word. It is the one flourish on the page — a hand on an
          otherwise exact surface — and it is drawn, not a rule. */}
      <h1 class="ml-drawn-head"><span class="ml-drawn">Thank you</span>.</h1>
      <p class="ml-lede">Your support pays for the servers. That is what keeps every MarkLayer tool free for everyone.</p>
      <p>Polar emails your receipt. There is nothing to set up, and nothing to sign in to.</p>
      <p>You can close this tab. The page you were annotating is still open, with your work on it.</p>
      <p class="mt-10">
        <a class="ml-cta" href="/">Back to MarkLayer</a>
      </p>
      <p class="ml-meta mt-6">
        What this pays for, and the free ways to help instead: <a href="/support">the support page</a>.
      </p>
    </div>
    <SiteFooter />

    {/* The one script in this workspace, which otherwise ships zero client JS.
        It tells an editor still open in another tab that the payment landed, so
        the thank-you can happen where the person actually is instead of only on
        the page they are about to close. Same-origin, no order data, and
        entirely best-effort: no BroadcastChannel (old Safari) or no editor tab
        open costs a toast and nothing else. */}
    <script is:inline define:vars={{ channel: SUPPORT_CHANNEL, paid: SUPPORT_PAID }}>
      try {
        // Deliberately never closed: `postMessage` is asynchronous, and closing
        // the channel in the same tick can drop the message before it is sent.
        // Unloading the page closes it.
        new BroadcastChannel(channel).postMessage(paid);
      } catch {
        // No BroadcastChannel, or a context that refuses it. The page is the
        // ending either way.
      }
    </script>
  </body>
</html>
