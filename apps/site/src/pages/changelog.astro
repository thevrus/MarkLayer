---
import dates from '../data/page-dates.json';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getReleases } from '../lib/collections';
import { articleSchema } from '../lib/schema';
import { formatReleaseDate } from '../lib/site';

const releases = await getReleases();
const { published, modified } = dates['hub-changelog'];

/* Only the `new` titles reach the hub. What a release ADDED is the thing worth
   scanning a changelog for; the improvements and the fixes need a sentence each
   to mean anything, and they get one on the release's own page. */
const entries = releases.map((r) => ({
  slug: r.id,
  data: r.data,
  features: r.data.changes.filter((c) => c.kind === 'new').map((c) => c.title),
}));

const current = releases.at(0)?.data.version;

const path = '/changelog';
const title = 'MarkLayer Changelog: What Shipped in Every Release';
const description =
  'Release notes for MarkLayer, newest first. Every annotation tool, collaboration feature and fix, with the version and the date it shipped. Free, no account required.';
const h1 = "What's new in MarkLayer";
---

<ArticleLayout
  title={title}
  description={description}
  path={path}
  h1={h1}
  breadcrumbs={[{ name: 'MarkLayer', path: '/' }, { name: 'Changelog' }]}
  modified={modified}
  schema={[articleSchema({ h1, description, path, published, modified })]}
>
  <Fragment slot="intro">
    Every release of the annotation tool, newest first. There is no paid tier and nothing is held back for one, so
    every feature on this page is in {current ? `${current}, the version` : 'the version'} you can install today.
  </Fragment>

  {
    entries.map((r) => (
      <article class="ml-release">
        <div>
          <span class="ml-release-version">{r.data.version}</span>
          <time class="ml-release-date" datetime={r.data.date}>
            {formatReleaseDate(r.data.date)}
          </time>
        </div>
        <div class="ml-release-body">
          <h2 class="ml-release-title">
            <a href={`/changelog/${r.slug}`}>{r.data.name}</a>
          </h2>
          <p>{r.data.summary}</p>
          {r.features.length > 0 && (
            <ul>
              {r.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))
  }
</ArticleLayout>
