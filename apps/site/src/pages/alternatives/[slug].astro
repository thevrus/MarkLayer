---
import { render } from 'astro:content';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAlternatives, getComparisons, getCompetitorPrices, relatedLinks } from '../../lib/collections';
import { articleSchema, type Crumb, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const [alternatives, comparisons] = await Promise.all([getAlternatives(), getComparisons()]);

  const prices = getCompetitorPrices(comparisons).map((p) => [p.id, p.price] as const);

  return alternatives.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prices,
      related: relatedLinks({
        entry,
        siblings: alternatives,
        others: comparisons,
        siblingLink: (a) => ({ href: `/alternatives/${a.id}`, label: `Free ${a.data.target} alternatives` }),
        crossLink: (c) => ({ href: `/vs/${c.id}`, label: `MarkLayer vs ${c.data.competitor}` }),
      }),
    },
  }));
}

const { entry, related, prices } = Astro.props;
const a = entry.data;
const { Content } = await render(entry);

const path = `/alternatives/${entry.id}`;
const h1 = `Free ${a.target} alternatives`;

/**
 * What someone shopping alternatives actually wants is the prices side by side,
 * and that is the one thing the `/vs/<slug>` twin cannot show: it compares a
 * single competitor, not the whole shortlist. Each option that links to a
 * comparison page resolves to that page's own Price row, so this table quotes
 * nothing of its own.
 *
 * Deliberately the unfiltered set, not `getPublishedPrices`: that one drops rows
 * carrying no figure so `/pricing` can list concrete numbers, and here every row
 * needs a value — "Paid (subscription per user)" is worth more than a blank.
 */
const priceRows = new Map(prices);
const priceFor = (url?: string): string => {
  if (url === '/') return 'Free. No tiers, no seats';
  const slug = url?.startsWith('/vs/') ? url.slice('/vs/'.length) : undefined;
  return (slug && priceRows.get(slug)) || 'Not tracked';
};
const breadcrumbs: Crumb[] = [
  { name: 'MarkLayer', path: '/' },
  { name: 'Alternatives', path: '/alternatives' },
  { name: h1 },
];
---

<ArticleLayout
  title={a.title}
  description={a.description}
  path={path}
  h1={h1}
  bottomLine={a.bottomLine}
  breadcrumbs={breadcrumbs}
  modified={a.modified}
  schema={[
    articleSchema({ h1, description: a.description, path, published: a.published, modified: a.modified }),
    faqSchema(a.faq),
  ]}
>
  <Content slot="intro" />

  {/* The summary table carries `bestFor` and the price; the entries below carry
      the prose. Splitting them that way keeps the same fact from appearing
      twice on one page, which is what a "Best for" line under every pitch did. */}
  <h2>{a.target} alternatives compared</h2>
  <div class="ml-scroll-x">
    <table class="min-w-136">
      <thead>
        <tr>
          <th scope="col" class="w-[26%]">Option</th>
          <th scope="col" class="w-[36%]">Price</th>
          <th scope="col">Best for</th>
        </tr>
      </thead>
      <tbody>
        {
          a.options.map((o) => (
            <tr>
              <th scope="row">{o.url ? <a href={o.url}>{o.name}</a> : o.name}</th>
              <td>{priceFor(o.url)}</td>
              <td>{o.bestFor}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="ml-meta">
    Prices as published by each vendor, checked August 2026, and read from each tool's own
    <a href="/compare">comparison page</a>. "Not tracked" means there is no comparison page for that option yet, so
    no price is quoted for it here.
  </p>

  <h2>Top free {a.target} alternatives</h2>
  {
    a.options.map((o, i) => (
      <div class="ml-entry">
        <h3>
          {i + 1}. {o.url ? <a href={o.url}>{o.name}</a> : o.name}
        </h3>
        <p>{o.pitch}</p>
      </div>
    ))
  }

  <Faq qa={a.faq} />
  <Related title="Related comparisons" links={related} />
</ArticleLayout>
