---
import claudeSvg from '@lobehub/icons-static-svg/icons/claude.svg?raw';
import codexSvg from '@lobehub/icons-static-svg/icons/codex.svg?raw';
import { siClaude, siCline, siCursor, siGithubcopilot, siGooglegemini, siNpm, siWindsurf, siZedindustries } from 'simple-icons';
import BaseHead from '../components/BaseHead.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import dates from '../data/page-dates.json';
import { AGENT_TOOL_GROUPS, AGENT_TOOLS } from '../lib/agent-tools';
import { MCP_CLIENTS, MCP_HABIT, MCP_PROMPTS, ROOM_MCP_URL } from '../lib/mcp-setup';
import { articleSchema, breadcrumbSchema, faqSchema, howToSchema, type QA } from '../lib/schema';
import { ORIGIN } from '@marklayer/brand';
import { pageOgImage } from '../lib/site';

const { published, modified } = dates.mcp;

const path = '/mcp';
const h1 = 'Give the review to your agent.';
const title = 'MarkLayer MCP: Claude Code, Cursor or Codex Does the Review';
const description =
  'Every MarkLayer share link is a remote MCP server. Add it to Claude Code, Codex, Cursor or VS Code in one line; your agent reads reviewer marks and fixes them.';

/* Real marks only, on one 24-grid: simple-icons where it has the brand, and
   the set the footer already uses for Codex. VS Code wears the Copilot mark,
   because Copilot is what reads `.vscode/mcp.json`. */
type Mark = { path?: string; svg?: string };
const CLAUDE: Mark = { path: siClaude.path };
const CURSOR: Mark = { path: siCursor.path };
const CODEX: Mark = { svg: codexSvg };
const COPILOT: Mark = { path: siGithubcopilot.path };
const marks: Record<string, Mark> = {
  'claude-code': CLAUDE,
  claude: { svg: claudeSvg },
  codex: CODEX,
  cursor: CURSOR,
  vscode: COPILOT,
  npm: { path: siNpm.path },
};

/* The agents whose marks the product draws when they join a room. */
const agents: { label: string; mark: Mark }[] = [
  { label: 'Claude Code', mark: CLAUDE },
  { label: 'Cursor', mark: CURSOR },
  { label: 'Codex', mark: CODEX },
  { label: 'Copilot', mark: COPILOT },
  { label: 'Windsurf', mark: { path: siWindsurf.path } },
  { label: 'Cline', mark: { path: siCline.path } },
  { label: 'Zed', mark: { path: siZedindustries.path } },
  { label: 'Gemini', mark: { path: siGooglegemini.path } },
];

const qa: QA[] = [
  {
    q: 'Does MarkLayer have an MCP server?',
    a: `Yes, two ways in to the same ${AGENT_TOOLS.length} tools. Every share link answers MCP over Streamable HTTP at its own address plus /mcp, so a client that supports remote servers connects with one command and nothing installed. For clients that only run local servers, the same tools ship on npm as marklayer-mcp.`,
  },
  {
    q: 'Do I need an API key or an account to connect an agent?',
    a: 'No. A MarkLayer share link is its own access token: whoever holds the link can open it, and the MCP endpoint follows the same rule. There is no OAuth step and no key to paste. If the owner has locked the link with a password, send it as a header (Authorization: Bearer <password>; in Claude Code, --header) or use the npm package with MARKLAYER_PASSWORD.',
  },
  {
    q: 'Which coding agents work with MarkLayer?',
    a: 'Any MCP client. This page has setup for Claude Code, Claude, Codex, Cursor and VS Code. Windsurf, Zed, Cline, Gemini CLI and anything else that reads an mcpServers config work through either the remote URL or the npm package.',
  },
  {
    q: 'Can the agent change the website I annotated?',
    a: 'Not through MarkLayer. MarkLayer never touches the page’s source. The agent reads the comments, edits your code with its own tools, and reports back in the room. What it can change in MarkLayer is the review itself: statuses, replies, its own comments, suggested edits, a checklist and polls.',
  },
  {
    q: 'Why connect over the remote URL instead of npm?',
    a: 'You have nothing to install or update, because the endpoint ships with the site. What you give up is scope. The remote URL is bound to one share link, so a new link means a new connection. The npm package is installed once and switches between links with marklayer_connect_room.',
  },
  {
    q: 'How do I know the connection worked?',
    a: 'Seeing the server listed is not proof. Ask the agent to call marklayer_room_info: it should answer with the URL the link annotates. A 401 means the link’s owner has locked it, and it wants the password. If the agent says it has no MarkLayer tools, the session predates the config; start a new one.',
  },
];

const schema = [
  articleSchema({ h1, description, path, published, modified }),
  howToSchema({
    name: 'Connect Claude Code to a MarkLayer share link',
    description: 'Add a MarkLayer room as a remote MCP server and let the agent work its annotations.',
    steps: [
      { name: 'Copy the MCP address', text: 'Open the Details panel on any MarkLayer link. The MCP address is the link plus /mcp.' },
      { name: 'Add the server', text: `Run: claude mcp add --transport http marklayer ${ROOM_MCP_URL}` },
      { name: 'Load the tools', text: 'Run /mcp in Claude Code, or start a new session, so the tools are listed.' },
      { name: 'Check it', text: 'Ask the agent to call marklayer_room_info. It answers with the URL under review.' },
    ],
  }),
  faqSchema(qa),
  breadcrumbSchema([{ name: 'MarkLayer', path: '/' }, { name: 'MCP' }]),
];
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={`${ORIGIN}${path}`}
      ogImage={pageOgImage({ heading: h1, path })}
      ogType="website"
      schema={schema}
    >
      <link slot="extra-links" rel="alternate" type="text/markdown" href="/mcp.md" title="Setup instructions for agents" />
    </BaseHead>
  </head>
  <body>
    <SiteHeader path={path} />
    <main class="ml-shell">
      <section class="mx-auto max-w-[760px] pt-10 text-center sm:pt-16">
        <h1 class="mcp-voice text-display text-ink text-balance">{h1}</h1>
        <p class="mcp-voice mx-auto mt-5 max-w-[560px] text-lede text-meta text-pretty">
          Every MarkLayer link is an MCP server. Your coding agent reads what reviewers marked on the page, fixes it,
          and ticks each comment off while they watch.
        </p>
      </section>

      <section class="mx-auto mt-12 max-w-[720px]" data-mcp-tabs>
        <div class="flex flex-wrap items-center justify-center gap-1" role="tablist" aria-label="Your client">
          {
            MCP_CLIENTS.map((c, i) => (
              <button
                type="button"
                role="tab"
                id={`mcp-tab-${c.id}`}
                aria-controls={`mcp-panel-${c.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="mcp-tab"
              >
                {marks[c.id].svg ? (
                  <span class="mcp-mark" set:html={marks[c.id].svg} />
                ) : (
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                    <path d={marks[c.id].path} />
                  </svg>
                )}
                {c.label}
              </button>
            ))
          }
        </div>
        {
          MCP_CLIENTS.map((c, i) => (
            <div
              id={`mcp-panel-${c.id}`}
              role="tabpanel"
              aria-labelledby={`mcp-tab-${c.id}`}
              hidden={i !== 0}
              tabindex="0"
              class="mt-5"
            >
              <CodeBlock code={c.code} lang={c.lang} class="my-0" label={c.file ?? (c.lang === 'bash' ? 'Terminal' : 'Remote MCP URL')} />
              <p class="mt-3 mb-0 text-site-ui text-meta text-pretty">{c.after}</p>
            </div>
          ))
        }
        <p class="mt-6 text-center text-site-ui text-meta">
          The address is any share link plus <code>/mcp</code>; the Details panel on the link shows it filled in. Add
          <code>?agent=cursor</code>, or any name, so reviewers see who picked their comment up.
        </p>
      </section>

      <section class="mx-auto mt-24 max-w-[960px] sm:mt-32">
        <h2 class="mcp-voice m-0 text-title text-ink text-balance">
          One comment, start to finish.
          <span class="text-meta"> The reviewer never leaves the page. The agent never asks what was clicked.</span>
        </h2>
        <div class="mcp-stage mt-10">
          <div class="mcp-thread">
            <div class="mcp-pin" aria-hidden="true">3</div>
            <div class="min-w-0">
              <p class="m-0 text-site-ui text-ink">
                <strong class="font-medium">Priya</strong>
                <span class="text-meta"> · hero button</span>
              </p>
              <p class="mt-1 mb-0 text-site-body text-ink text-pretty">
                This still says “Submit”. It should say “Start trial” like the pricing page.
              </p>
              <div class="mcp-target">
                <span class="text-meta">button</span>
                <code>main &gt; section.hero button.cta</code>
              </div>
              <ol class="mcp-status">
                <li>Open</li>
                <li>In progress · claude</li>
                <li data-done>Resolved</li>
              </ol>
              <div class="mcp-reply">
                <p class="m-0 text-site-ui text-ink">
                  <strong class="font-medium">claude</strong>
                  <span class="text-meta"> · reply</span>
                </p>
                <p class="mt-1 mb-0 text-site-ui text-ink text-pretty">
                  Renamed the CTA in <code>Hero.tsx:42</code> and the matching test. Deployed to the preview.
                </p>
              </div>
            </div>
          </div>
          <ol class="mcp-log" aria-label="What the agent called">
            <li>
              <code>watch_annotations</code>
              <span>new comment 3, with target selector and markup</span>
            </li>
            <li>
              <code>acknowledge</code>
              <span>pin flips to in progress on Priya’s screen</span>
            </li>
            <li class="mcp-log-edit">
              <span>
                edits <code>src/Hero.tsx</code>, runs the tests
              </span>
            </li>
            <li>
              <code>resolve</code>
              <span>summary posted as the reply above</span>
            </li>
            <li>
              <code>watch_annotations</code>
              <span>waiting for the next one</span>
            </li>
          </ol>
        </div>
        <p class="mt-3 mb-0 text-label text-meta">A worked example. The reviewer, the page and the file are made up; the calls are the real ones.</p>
        <ul class="mcp-claims">
          <li>
            <strong>It knows what you clicked.</strong> Each comment arrives with the element it was left on: a selector,
            a text fingerprint, a snapshot, and on a React, Vue or Svelte page the component chain.
          </li>
          <li>
            <strong>You watch it work.</strong> Seen, replied, done. Every status change lands on the pin while the thread
            is still open.
          </li>
          <li>
            <strong>Wording fixes come back exact.</strong> A typo or a better sentence comes back as a diff to accept,
            never prose describing one.
          </li>
        </ul>
      </section>

      <section class="mx-auto mt-24 max-w-[760px] text-center sm:mt-32">
        <p class="mcp-voice m-0 text-heading text-ink">Any MCP client.</p>
        <ul class="m-0 mt-6 flex list-none flex-wrap items-center justify-center gap-x-7 gap-y-3 p-0 text-site-ui text-ink">
          {
            agents.map((a) => (
              <li class="m-0 inline-flex items-center gap-2 p-0">
                {a.mark.svg ? (
                  <span class="mcp-mark" set:html={a.mark.svg} />
                ) : (
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                    <path d={a.mark.path} />
                  </svg>
                )}
                {a.label}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mx-auto mt-24 max-w-[760px] sm:mt-32">
        <h2 class="mcp-voice m-0 text-title text-ink text-balance">
          {AGENT_TOOLS.length} tools.
          <span class="text-meta"> Everything the room can tell an agent, and everything an agent can do back.</span>
        </h2>
        <div class="mt-8">
          {
            AGENT_TOOL_GROUPS.map((g) => (
              <div class="mcp-group">
                <p class="mcp-group-name">{g.group}</p>
                <dl class="m-0">
                  {g.tools.map((t) => (
                    <div class="mcp-tool">
                      <dt>
                        <code>marklayer_{t.name}</code>
                      </dt>
                      <dd>{t.does}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mx-auto mt-24 max-w-[760px] sm:mt-32">
        <h2 class="mcp-voice m-0 text-title text-ink text-balance">
          It works the other way too.
          <span class="text-meta"> When the agent has built something, it hands you a room instead of a paragraph.</span>
        </h2>
        <p class="mt-6 text-site-body text-ink text-pretty">
          <code>share_preview</code> opens a review room on the preview URL and returns the link. A later preview of the
          same repository and branch becomes the next version of that room, so reviewers step between them. The agent
          posts its plan as a checklist that ticks off as the work lands, and when it needs a decision rather than an
          opinion, it asks the room to vote.
        </p>
        <p class="mt-4 text-site-body text-ink text-pretty">
          Agents forget a tool exists unless something reminds them. Paste this into <code>CLAUDE.md</code> or
          <code>AGENTS.md</code> and yours will reach for MarkLayer on its own:
        </p>
        <CodeBlock code={MCP_HABIT} lang="markdown" label="CLAUDE.md / AGENTS.md" />
        <p class="text-site-body text-ink text-pretty">Or just say it:</p>
        <blockquote class="mcp-prompt">{MCP_PROMPTS.work}</blockquote>
        <blockquote class="mcp-prompt">{MCP_PROMPTS.review}</blockquote>
        <p class="mt-6 text-site-ui text-meta">
          Pointing an agent at the setup itself? <a href="/mcp.md">Plain-text instructions for agents</a>.
        </p>
      </section>

      <section class="mx-auto mt-24 max-w-[760px] sm:mt-32">
        <Faq qa={qa} />
      </section>

      <section class="mx-auto mt-20 mb-24 max-w-[760px] text-center sm:mt-28">
        <p class="mcp-voice m-0 text-title text-ink text-balance">Free, with no account, for everyone on the link.</p>
        <p class="mt-4 text-site-body text-meta">
          <a href="/">Annotate a page</a> · <a href="/features">Every feature</a> ·
          <a href="/guides/bug-report-mcp-servers">How other tools’ MCP servers compare</a>
        </p>
      </section>
    </main>
    <SiteFooter />

    <style>
      @reference "../styles/global.css";

      /* The landing page's own voice, `--ml-font-voice` in apps/worker/web/style.css:
         a regular 400 Arial, hierarchy from size and tone rather than mass. */
      .mcp-voice {
        font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
        font-weight: 400;
      }
      .mcp-tab {
        @apply inline-flex h-9 cursor-pointer items-center gap-2 rounded-full border-0 bg-transparent px-3.5 text-site-ui text-meta transition-colors duration-150;
      }
      .mcp-tab:hover {
        @apply bg-ink/5 text-ink;
      }
      .mcp-tab[aria-selected='true'] {
        @apply bg-ink text-canvas;
      }
      .mcp-mark {
        @apply inline-block size-[15px] shrink-0;
      }
      .mcp-mark :global(svg) {
        @apply block size-full;
      }

      /* The worked comment: a thread on the left, the agent's calls on the right,
         one ring around both. */
      .mcp-stage {
        @apply grid overflow-hidden rounded-2xl bg-canvas shadow-ring md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)];
      }
      .mcp-thread {
        @apply flex gap-4 p-6 sm:p-8;
      }
      .mcp-pin {
        @apply flex size-7 shrink-0 items-center justify-center rounded-full bg-ink text-label font-semibold text-canvas tabular-nums;
      }
      .mcp-target {
        @apply mt-3 flex flex-wrap items-center gap-x-2 rounded-md bg-sunken px-2.5 py-1.5 text-label;
      }
      .mcp-target code {
        @apply bg-transparent p-0 text-ink;
      }
      .mcp-status {
        @apply m-0 mt-4 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 text-label;
      }
      .mcp-status li {
        @apply m-0 p-0 text-meta;
      }
      .mcp-status li + li::before {
        content: '→';
        @apply me-2 text-faint;
      }
      .mcp-status li[data-done] {
        @apply font-medium text-live;
      }
      .mcp-reply {
        @apply mt-4 border-s-2 border-rule ps-3;
      }
      .mcp-log {
        @apply m-0 flex list-none flex-col gap-3 border-rule bg-sunken p-6 text-label sm:p-8 md:border-s;
      }
      .mcp-log li {
        @apply m-0 grid grid-cols-[9.5rem_1fr] items-baseline gap-3 p-0 text-meta;
      }
      .mcp-log code {
        @apply bg-transparent p-0 text-ink;
      }
      .mcp-log-edit span {
        @apply col-span-2 italic;
      }
      .mcp-claims {
        @apply m-0 mt-10 grid list-none gap-6 p-0 text-site-body text-meta md:grid-cols-3;
      }
      .mcp-claims li {
        @apply m-0 p-0 text-pretty;
      }
      .mcp-claims strong {
        @apply block font-medium text-ink;
      }

      .mcp-group + .mcp-group {
        @apply mt-8;
      }
      .mcp-group-name {
        @apply m-0 border-b border-ink pb-2 text-label font-semibold text-ink;
      }
      .mcp-tool {
        @apply grid gap-x-6 gap-y-1 border-b border-rule py-3 sm:grid-cols-[15rem_1fr];
      }
      .mcp-tool dt {
        @apply m-0 text-site-ui;
      }
      .mcp-tool dd {
        @apply m-0 text-site-ui text-meta text-pretty;
      }
      .mcp-prompt {
        @apply my-4 rounded-xl bg-sunken px-5 py-4 text-site-body text-ink text-pretty;
      }
    </style>

    <script>
      import { wireCodeCopy } from '../lib/copy-button';

      /* Tabs: one panel at a time, arrow keys move between them. Every panel is
         in the markup, so a reader with no script still gets the first one. */
      const root = document.querySelector('[data-mcp-tabs]');
      const tabs = root ? Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]')) : [];
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !on;
        }
        tab.focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const next =
            e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? -1 : null;
          if (next === null) return;
          e.preventDefault();
          const target = tabs.at(next % tabs.length);
          if (target) select(target);
        });
      });

      wireCodeCopy();
    </script>
  </body>
</html>
