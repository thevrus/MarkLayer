# Marketing pages are served straight from the asset layer, so they never run
# the Worker's HSTS middleware (apps/worker/src/index.ts). Reapply it here.
# Per-route Cache-Control is appended at build from src/data/routes.json
# (scripts/emit-headers.mjs).
#
# Scoped deliberately: `/*` carries HSTS only. The SPA shell at `/` must not
# inherit a one-hour max-age, or an app deploy would take an hour to reach
# browsers that already have it cached.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Self-hosted webfonts. Content-addressed by name — a new cut ships under a new
# filename — so they can be cached for a year and never revalidated. The
# crossorigin preload in BaseHead.astro makes these anonymous-mode requests, and
# a font fetched in anonymous mode is cached separately from one that is not, so
# the CORS header has to be here even though this is same-origin.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
