# The only image in this repo is apps/fetcher, and it needs exactly two source
# trees. Without this the build context is 2.3 GB of node_modules and gets
# re-uploaded to the remote builder on every deploy.
node_modules
**/node_modules
.git
.github
.turbo
.wrangler
.playwright-mcp
.vscode
**/dist
**/.output
**/.astro

# Workspaces the image does not contain.
apps/extension
apps/site
apps/worker
apps/mcp
docs
